# Ortam değişkenleri örneği — gerçek değerleri .env dosyasında tutun (.env commit edilmez).
# Bu üç değer olmadan sunucu otomatik olarak examples/data içindeki örnek veriyle çalışır.

# Trendyol satıcı numarası (panelde "Satıcı ID" olarak geçer)
TRENDYOL_SUPPLIER_ID=123456

# Trendyol Marketplace Integration API anahtarı ve şifresi
TRENDYOL_API_KEY=your-api-key
TRENDYOL_API_SECRET=your-api-secret

# (Opsiyonel) Farklı bir ortam/sandbox kullanıyorsanız
# TRENDYOL_BASE_URL=https://apigw.trendyol.com

# (Opsiyonel) Örnek veri klasörünü değiştirmek için
# TRENDYOL_MCP_FIXTURES=C:/path/to/fixtures
